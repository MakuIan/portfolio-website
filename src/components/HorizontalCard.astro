---
import { Image } from "astro:assets";
import { getTagColorClass } from "../lib/tagColors";

interface Props {
  title: string;
  img: string;
  desc: string;
  url: string;
  github?: string;
  badge?: string;
  tags?: string[];
  target?: string;
  loading?: "eager" | "lazy";
  detailsUrl?: string;
  detailsLabel?: string;
}

const {
  title,
  img,
  desc,
  url,
  github,
  badge,
  tags,
  target = "_blank",
  loading = "lazy",
  detailsUrl,
  detailsLabel,
} = Astro.props;
---

<div
  class="mb-4 rounded-lg border border-base-200 bg-base-100 p-4 transition ease-in-out hover:scale-[101%] hover:shadow-xl"
>
  <div
    class="hero-content flex-col items-start p-0 md:flex-row md:items-center"
  >
    {
      img && (
        <a
          href={detailsUrl || url || github || "#"}
          target={detailsUrl ? "_self" : target}
          class="w-full md:w-auto"
        >
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            loading={loading}
            class="max-w-full rounded-lg object-cover shadow-sm md:max-w-[14rem]"
          />
        </a>
      )
    }
    <div class="w-full grow">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h1 class="flex items-center gap-2 text-xl font-bold">
          <a
            href={detailsUrl || url || github || "#"}
            target={detailsUrl ? "_self" : target}
            class="hover:underline"
          >
            {title}
          </a>
          {badge && <div class="badge badge-secondary">{badge}</div>}
        </h1>
        <div class="flex flex-wrap items-center gap-2">
          {
            detailsUrl && (
              <a
                href={detailsUrl}
                class="btn btn-primary btn-sm gap-1.5 font-medium shadow-sm"
                title={detailsLabel || "Case Study"}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                </svg>
                {detailsLabel || "Case Study"}
              </a>
            )
          }
          {
            url && (
              <a
                href={url}
                target="_blank"
                class="btn btn-outline btn-sm gap-2 font-normal hover:bg-neutral hover:text-neutral-content"
                title="Open website"
                aria-label="Open website"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2Zm7.93 9h-3.064A15.56 15.56 0 0 0 14.8 5.2 8.026 8.026 0 0 1 19.93 11ZM12 4.07A13.462 13.462 0 0 1 13.86 11H10.14A13.462 13.462 0 0 1 12 4.07ZM4.07 13h3.064A15.56 15.56 0 0 0 9.2 18.8 8.026 8.026 0 0 1 4.07 13Zm3.064-2H4.07a8.026 8.026 0 0 1 5.13-6.8A15.56 15.56 0 0 0 9.2 11Zm2.879 8.93A13.462 13.462 0 0 1 10.14 13h3.72a13.462 13.462 0 0 1-1.86 7.93ZM19.93 13h-3.064A15.56 15.56 0 0 0 14.8 18.8 8.026 8.026 0 0 1 19.93 13Zm-9.9-2h7.94a13.847 13.847 0 0 1-.77 4.82A13.541 13.541 0 0 1 10.03 11Zm0-2A13.541 13.541 0 0 1 13.97 13H10.03A13.847 13.847 0 0 1 9.26 9.18Z" />
                </svg>
              </a>
            )
          }
          {
            github && (
              <a
                href={github}
                target="_blank"
                class="btn btn-outline btn-sm gap-2 font-normal hover:bg-neutral hover:text-neutral-content"
                title="View on GitHub"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
                GitHub
              </a>
            )
          }
        </div>
      </div>
      <p class="whitespace-pre-line py-2 text-base text-base-content/80">
        {desc}
      </p>
      {
        tags && (
          <div class="card-actions mt-2 justify-start">
            {tags.map((tag) => (
              <span
                class={`badge border text-xs font-medium ${getTagColorClass(tag)}`}
              >
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
