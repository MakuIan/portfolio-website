---
import LanguagePicker from "./LanguagePicker.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="px-4 pb-4 pt-1 flex justify-center hidden lg:flex">
  <LanguagePicker />
</div>

<ul class="menu grow shrink menu-md overflow-y-auto">
    <li><a class="py-3 text-base" id="home" href={`/${lang}/`}>{t('nav.home')}</a></li>
    <li><a class="py-3 text-base" id="projects" href={`/${lang}/projects`}>{t('nav.projects')}</a></li>
    <li><a class="py-3 text-base" id="cv" href={`/${lang}/cv`}>{t('nav.cv')}</a></li>
    <li><a class="py-3 text-base" id="contact" href={`/${lang}/contact`}>{t('nav.contact')}</a></li>
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add(activeClass);
</script>
