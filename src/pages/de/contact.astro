---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t("contact.title")} sideBarActiveItemID="contact">
  <div class="mb-5">
    <div class="w-full text-3xl font-bold">{t("contact.title")}</div>
    <p class="mt-2 text-base text-base-content/70">{t("contact.subtitle")}</p>
  </div>

  <div
    class="mb-8 rounded-lg border border-base-300 bg-base-200/50 p-4 italic text-base-content/70"
  >
    {t("contact.placeholder")}
  </div>

  <div class="card max-w-xl border border-base-200 bg-base-100 p-6 shadow-sm">
    <form
      class="space-y-4"
      onsubmit="event.preventDefault(); alert('Formular abgesendet!');"
    >
      <div>
        <label class="label font-medium">{t("contact.name")}</label>
        <input
          type="text"
          placeholder="[ Name ]"
          class="input input-bordered w-full"
        />
      </div>

      <div>
        <label class="label font-medium">{t("contact.email")}</label>
        <input
          type="email"
          placeholder="[ email@beispiel.de ]"
          class="input input-bordered w-full"
        />
      </div>

      <div>
        <label class="label font-medium">{t("contact.message")}</label>
        <textarea
          placeholder="[ Nachricht ]"
          class="textarea textarea-bordered h-32 w-full"></textarea>
      </div>

      <button type="submit" class="btn btn-primary w-full">
        {t("contact.send")}
      </button>
    </form>
  </div>
</BaseLayout>
