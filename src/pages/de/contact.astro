---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('contact.title')} sideBarActiveItemID="contact">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{t('contact.title')}</div>
    <p class="text-base text-base-content/70 mt-2">{t('contact.subtitle')}</p>
  </div>

  <div class="mb-8 p-4 bg-base-200/50 rounded-lg border border-base-300 italic text-base-content/70">
    {t('contact.placeholder')}
  </div>

  <div class="card bg-base-100 border border-base-200 shadow-sm p-6 max-w-xl">
    <form class="space-y-4" onsubmit="event.preventDefault(); alert('Formular abgesendet!');">
      <div>
        <label class="label font-medium">{t('contact.name')}</label>
        <input type="text" placeholder="[ Name ]" class="input input-bordered w-full" />
      </div>

      <div>
        <label class="label font-medium">{t('contact.email')}</label>
        <input type="email" placeholder="[ email@beispiel.de ]" class="input input-bordered w-full" />
      </div>

      <div>
        <label class="label font-medium">{t('contact.message')}</label>
        <textarea placeholder="[ Nachricht ]" class="textarea textarea-bordered w-full h-32"></textarea>
      </div>

      <button type="submit" class="btn btn-primary w-full">
        {t('contact.send')}
      </button>
    </form>
  </div>
</BaseLayout>
