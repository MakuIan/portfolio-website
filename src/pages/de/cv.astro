---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TimeLineElement from "../../components/cv/TimeLine.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t("cv.title")} sideBarActiveItemID="cv">
  <div class="mb-5">
    <div class="w-full text-3xl font-bold">{t("cv.profileTitle")}</div>
  </div>

  <div
    class="mb-10 rounded-r border-l-4 border-primary bg-base-200/50 py-2 pl-4 text-justify italic text-base-content/70"
  >
    {t("cv.profileDesc")}
  </div>

  <!-- <div class="mb-5">
    <div class="w-full text-3xl font-bold">{t("cv.experienceTitle")}</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="[ Job Title / Position ]"
      subtitle="[ Start Date ] - [ End Date ] | [ Company Name / Location ]"
      >≤˚
      {t("cv.experienceDesc")}
    </TimeLineElement>
    <TimeLineElement
      title="[ Job Title / Position ]"
      subtitle="[ Start Date ] - [ End Date ] | [ Company Name / Location ]"
    >
      {t("cv.experienceDesc")}
    </TimeLineElement>
  </div> -->

  <div class="time-line-container mb-10" aria-hidden="true"></div>

  <div class="mb-5">
    <div class="w-full text-3xl font-bold">{t("cv.educationTitle")}</div>
  </div>

  <div class="time-line-container mb-10 grid gap-4">
    <TimeLineElement
      title="B.Sc. Informatik"
      subtitle="2023 - Heute | Goethe-Universität Frankfurt"
    />
    <TimeLineElement
      title="Abitur"
      subtitle="2018 - 2023 | Martin-Niemöller-Schule, Wiesbaden"
    />
  </div>

  <div class="mb-5">
    <div class="w-full text-3xl font-bold">{t("cv.skillsTitle")}</div>
  </div>

  <div class="mb-10">
    {
      t("cv.skillsDesc") && (
        <p class="mb-4 italic text-base-content/70">{t("cv.skillsDesc")}</p>
      )
    }
    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <h3 class="mb-2 font-semibold">{t("cv.skills.languages")}</h3>
        <ul class="list-disc space-y-1 pl-5">
          <li>TypeScript / JavaScript</li>
          <li>Python</li>
          <li>Java</li>
          <li>Dart</li>
        </ul>
      </div>
      <div>
        <h3 class="mb-2 font-semibold">{t("cv.skills.frameworks")}</h3>
        <ul class="list-disc space-y-1 pl-5">
          <li>React / Next.js</li>
          <li>SvelteKit / Svelte</li>
          <li>Astro</li>
          <li>Flutter</li>
          <li>Tailwind CSS</li>
        </ul>
      </div>
      <div>
        <h3 class="mb-2 font-semibold">{t("cv.skills.databases")}</h3>
        <ul class="list-disc space-y-1 pl-5">
          <li>PostgreSQL</li>
          <li>Convex</li>
          <li>Firestore</li>
        </ul>
      </div>
      <div>
        <h3 class="mb-2 font-semibold">{t("cv.skills.other")}</h3>
        <ul class="list-disc space-y-1 pl-5">
          <li>Git / GitHub</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="mb-5">
    <div class="w-full text-3xl font-bold">{t("cv.certificationsTitle")}</div>
  </div>

  <ul class="mx-6 mb-10 grid list-disc gap-2">
    <li class="italic text-base-content/70">
      {t("cv.certificationsDesc")}
    </li>
  </ul>
</BaseLayout>
