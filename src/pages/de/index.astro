---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="mt-5 pb-12">
    <div class="py-1 text-xl">{t("hero.greeting")}</div>
    <div class="text-5xl font-bold">{t("hero.title")}</div>
    <div class="py-3 text-3xl font-bold text-primary">{t("hero.subtitle")}</div>
    <div class="py-2">
      <p class="text-lg text-base-content/80">
        {t("hero.desc")}
      </p>
    </div>
    <div class="mt-8 flex flex-wrap gap-4">
      <a class="btn btn-primary" href={`/${lang}/contact`}
        >{t("hero.connect")}</a
      >
      <a
        href="https://github.com/MakuIan"
        target="_blank"
        class="btn btn-outline gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
          ></path>
        </svg>
        {t("hero.github")}
      </a>
    </div>
  </div>

  <div>
    <div class="mb-5 w-full text-3xl font-bold">
      {t("projects.title")}
      {"</"}{" >"}
    </div>
  </div>

  <HorizontalCard
    title="NexusFinance"
    img="/nexus-finance.png"
    desc={t("project.nexusfinance.desc")}
    url="https://nexusfinanceterminal.de/"
    github="https://github.com/MakuIan/NexusFinance"
    badge={t("project.nexusfinance.badge")}
    loading="eager"
    tags={[
      "SvelteKit",
      "BetterAuth",
      "Drizzle",
      "PostgreSQL",
      "Docker",
      "Python",
    ]}
  />

  <div class="mt-8 text-center">
    <a href={`/${lang}/projects`} class="btn btn-outline">
      {t("projects.viewAll")}
    </a>
  </div>
</BaseLayout>
