---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('projects.title')} sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-5">{t('projects.title')}</div>
    <p class="text-base text-base-content/70 mb-6">{t('projects.subtitle')}</p>
  </div>

  <HorizontalCard
    title="step-chef"
    img="/step-chef.png"
    desc={t('project.stepchef.desc')}
    url="https://github.com/MakuIan/step-chef"
    github="https://github.com/MakuIan/step-chef"
    badge="Featured"
    tags={["SvelteKit", "Convex", "TypeScript"]}
  />

  <HorizontalCard
    title="set-point"
    img="/post_img.webp"
    desc={t('project.setpoint.desc')}
    url="https://github.com/MakuIan/set-point"
    github="https://github.com/MakuIan/set-point"
    badge="SportsTech"
    tags={["SvelteKit", "Convex", "TypeScript"]}
  />

  <HorizontalCard
    title="NexusFinance"
    img="/post_img.webp"
    desc={t('project.nexusfinance.desc')}
    url="https://github.com/MakuIan/NexusFinance"
    github="https://github.com/MakuIan/NexusFinance"
    badge="FinTech"
    tags={["SvelteKit", "PostgreSQL", "TypeScript"]}
  />
</BaseLayout>
