---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t("contact.title")} sideBarActiveItemID="contact">
  <div class="mb-5">
    <div class="w-full text-3xl font-bold">{t("contact.title")}</div>
    <p class="mt-2 text-base text-base-content/70">{t("contact.subtitle")}</p>
  </div>

  <div
    class="mb-8 rounded-lg border border-base-300 bg-base-200/50 p-4 italic text-base-content/70"
  >
    {t("contact.placeholder")}
  </div>

  <div class="card max-w-xl border border-base-200 bg-base-100 p-6 shadow-sm">
    <form
      class="space-y-4"
      action="https://api.web3forms.com/submit"
      method="POST"
    >
      <input
        type="hidden"
        name="access_key"
        value="025a2114-f2ce-4fc4-a044-a4c6bb6fce9f"
      />
      <input
        type="hidden"
        name="subject"
        value="New portfolio contact message"
      />
      <input
        type="checkbox"
        name="botcheck"
        class="hidden"
        style="display: none;"
      />

      <div>
        <label for="contact-name" class="label font-medium"
          >{t("contact.name")}</label
        >
        <input
          type="text"
          id="contact-name"
          name="name"
          placeholder="[ Name ]"
          class="input input-bordered w-full"
          required
        />
      </div>

      <div>
        <label for="contact-email" class="label font-medium"
          >{t("contact.email")}</label
        >
        <input
          type="email"
          id="contact-email"
          name="email"
          placeholder="[ email@example.com ]"
          class="input input-bordered w-full"
          required
        />
      </div>

      <div>
        <label for="contact-message" class="label font-medium"
          >{t("contact.message")}</label
        >
        <textarea
          id="contact-message"
          name="message"
          placeholder="[ Message ]"
          class="textarea textarea-bordered h-32 w-full"
          required></textarea>
      </div>

      <button type="submit" class="btn btn-primary w-full">
        {t("contact.send")}
      </button>
    </form>
  </div>
</BaseLayout>
