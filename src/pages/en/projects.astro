---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="mb-5 w-full text-3xl font-bold">{t("projects.title")}</div>
    <p class="mb-6 text-base text-base-content/70">{t("projects.subtitle")}</p>
  </div>

  <HorizontalCard
    title="NexusFinance"
    img="/nexus-finance.png"
    desc={t("project.nexusfinance.desc")}
    url="https://nexusfinanceterminal.de/"
    github="https://github.com/MakuIan/NexusFinance"
    badge={t("project.nexusfinance.badge")}
    loading="eager"
    tags={[
      "SvelteKit",
      "BetterAuth",
      "Drizzle",
      "PostgreSQL",
      "Docker",
      "Python",
    ]}
  />

  <HorizontalCard
    title="set-point"
    img="/set-point.png"
    desc={t("project.setpoint.desc")}
    url="https://set-point.icmagmilch.workers.dev/"
    github="https://github.com/MakuIan/set-point"
    badge={t("project.setpoint.badge")}
    loading="eager"
    tags={["SvelteKit", "BetterAuth", "Convex", "TypeScript"]}
  />

  <HorizontalCard
    title="step-chef"
    img="/step-chef.png"
    desc={t("project.stepchef.desc")}
    url="https://step-chef.vercel.app/"
    github="https://github.com/MakuIan/step-chef"
    badge={t("project.stepchef.badge")}
    loading="eager"
    tags={["SvelteKit", "BetterAuth", "Convex", "TypeScript"]}
  />
</BaseLayout>
